# ---------------------------------------------------------------------------
# LeaseLens backend configuration (copy to .env and fill in what you need)
# ---------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# Comma separated list or JSON array for CORS.
# In production, list the exact origin that serves the UI, e.g.
# ALLOWED_ORIGINS=https://leaselens.example.com
# Leave ["*"] only when the API and the UI share an origin (the default: the API
# serves frontend/dist itself, so no cross-origin request ever happens).
ALLOWED_ORIGINS=["*"]

# ---- LLM provider ---------------------------------------------------------
# auto | gemini | anthropic | offline
#   auto      -> gemini if GEMINI_API_KEY else anthropic if ANTHROPIC_API_KEY
#                else offline (deterministic regex extraction, no network)
#   offline   -> never calls an LLM; used by tests and air-gapped demos
LLM_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=3
LLM_BATCH_SIZE=8
LLM_MAX_OUTPUT_TOKENS=8192
# When true the LLM rewrites the counter-clause / email draft in the tenant's
# voice. Off by default: templates are deterministic, auditable and cheap.
LLM_POLISH_FIXES=false

# ---- Upload / extraction limits ------------------------------------------
MAX_UPLOAD_MB=15
MAX_PAGES=100
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=60
OCR_DPI=300
OCR_LANGUAGES=eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Caching --------------------------------------------------------------
# Sessions (report + source PDF + annotated PDF) live in memory only.
# 0 = never expire (not recommended for uploads).
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=64
# Heap budget for cached PDFs; the least recently used session is evicted first.
CACHE_MAX_BYTES_MB=512
ANNOTATION_TTL_SECONDS=3600
# Analyse the three demo leases during startup so the first demo request is
# instant. They are pinned in the cache regardless of CACHE_TTL_SECONDS.
SAMPLE_WARM_ON_STARTUP=true

# ---- Privacy --------------------------------------------------------------
# Never log extracted lease text. Keep false in production.
LOG_RAW_TEXT=false

# ---- Paths (rarely changed) ----------------------------------------------
# RULES_FILE=app/rules/rules.yaml
# SAMPLES_DIR=app/data/samples

# ---- Frontend -------------------------------------------------------------
# When frontend/dist exists the API serves the built UI at "/" (the SPA uses
# hash routing, so no rewrite rule is needed) and these JSON/static routes keep
# working: /docs, /openapi.json, /api/v1/*, /assets/*, /brand/*.
SERVE_FRONTEND=true
# FRONTEND_DIST=frontend/dist
